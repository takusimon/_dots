{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "bar": {
      "char": {
        "elapsed": "■",
        "total": "■"
      },
      "width": 10
    },
    "color": {
      "keys": "220",
      "output": "223",
      "separator": "240",
      "title": "223"
    },
    "key": {
      "paddingLeft": 1,
      "width": 16
    },
    "percent": {
      "type": [
        "num",
        "num-color"
      ]
    },
    "separator": "  ",
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 2
    }
  },
  "logo": {
    "color": {
      "1": "#cc241d",
      "2": "#d65d0e",
      "3": "#d79921",
      "4": "#98971a",
      "5": "#689d6a",
      "6": "#458588",
      "7": "#b16286"
    },
    "height": 5,
    "padding": {
      "left": 2,
      "right": 3,
      "top": 1
    },
    "source": "NixOS_old",
    "type": "kitty-direct",
    "width": 5
  },
  "modules": [
    {
      "format": " ╭───────────╮",
      "type": "custom"
    },
    {
      "color": {
        "at": "223",
        "host": "223",
        "user": "167"
      },
      "format": "{user-name}",
      "key": "│  user    │",
      "type": "title"
    },
    {
      "format": "{host-name}",
      "key": "│  host    │",
      "outputColor": "214",
      "type": "title"
    },
    {
      "key": "│  distro  │",
      "outputColor": "142",
      "type": "os"
    },
    {
      "key": "│  kernel  │",
      "outputColor": "109",
      "type": "kernel"
    },
    {
      "compact": true,
      "key": "│  uptime  │",
      "outputColor": "108",
      "type": "uptime"
    },
    {
      "key": "│  shell   │",
      "outputColor": "175",
      "type": "shell"
    },
    {
      "key": "│  de/wm   │",
      "outputColor": "142",
      "type": "wm"
    },
    {
      "disabled": [
        "winget"
      ],
      "key": "│  pkgs    │",
      "outputColor": "167",
      "type": "packages"
    },
    {
      "key": "│  memory  │",
      "outputColor": "220",
      "percent": {
        "green": 50,
        "type": 0,
        "yellow": 80
      },
      "type": "memory"
    },
    {
      "key": "│  cpu     │",
      "showPeCoreCount": false,
      "temp": false,
      "type": "cpu"
    },
    {
      "detectionMethod": "pci",
      "driverSpecific": false,
      "hideType": "none",
      "key": "│ 󰾲 gpu     │",
      "temp": false,
      "type": "gpu"
    },
    {
      "hideFolders": "/efi:/boot:/boot/*",
      "key": "│  disk    │",
      "showExternal": true,
      "showHidden": false,
      "showReadOnly": true,
      "showRegular": true,
      "showSubvolumes": false,
      "showUnknown": false,
      "type": "disk"
    },
    {
      "key": "│  term    │",
      "type": "terminal"
    },
    {
      "key": "│  Age     │",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
      "type": "command"
    },
    {
      "format": " ├───────────┤",
      "type": "custom"
    },
    {
      "block": {
        "range": [
          0,
          7
        ],
        "width": 2
      },
      "key": "│  colors  │",
      "paddingLeft": 1,
      "symbol": "circle",
      "type": "colors"
    },
    {
      "format": " ╰───────────╯",
      "type": "custom"
    }
  ]
}
